{
  "version": 1,
  "storageKey": "adb-workbench.device-shortcuts.v1",
  "deviceStorageKey": "adb-workbench.device-shortcut-overrides.v1",
  "maxDeviceOverrides": 1000,
  "maxDeviceOverrideBytes": 2097152,
  "slots": ["slot-1", "slot-2", "slot-3", "slot-4"],
  "defaultActions": ["home", "sidebar", "settings", "childLockUnlock"],
  "actions": [
    { "id": "apps", "label": "应用管理" },
    { "id": "power", "label": "点亮 / 熄灭屏幕", "command": "input keyevent KEYCODE_POWER" },
    { "id": "home", "label": "回到桌面", "command": "input keyevent KEYCODE_HOME" },
    { "id": "back", "label": "返回", "command": "input keyevent KEYCODE_BACK" },
    { "id": "recents", "label": "最近任务", "command": "input keyevent KEYCODE_APP_SWITCH" },
    { "id": "notifications", "label": "通知栏", "command": "cmd statusbar expand-notifications" },
    { "id": "childLockUnlock", "label": "童锁解锁", "command": "input keyevent KEYCODE_VOLUME_DOWN KEYCODE_VOLUME_DOWN KEYCODE_VOLUME_UP KEYCODE_VOLUME_UP" },
    { "id": "volumeUp", "label": "音量+", "command": "input keyevent KEYCODE_VOLUME_UP" },
    { "id": "volumeDown", "label": "音量-", "command": "input keyevent KEYCODE_VOLUME_DOWN" },
    { "id": "sidebar", "label": "打开侧边栏", "packageName": "com.xbh.navisetting", "command": "am broadcast --user current -a com.xbh.action.show_control_panel -p com.xbh.navisetting" },
    { "id": "settings", "label": "打开系统设置", "packageName": "com.xbh.jyjsetting", "command": "am start --user current -W -n com.xbh.jyjsetting/.mainsetting.view.MainActivity" },
    { "id": "whiteboard", "label": "打开白板", "packageName": "com.xbh.whiteboard", "command": "am start --user current -W -n com.xbh.whiteboard/.LaunchActivity" }
  ]
}

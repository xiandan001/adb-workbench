{
  "appId": "com.scrcpy.gui",
  "productName": "卓控台",
  "artifactName": "adb-workbench-setup-${version}.${ext}",
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "icon.png"
  ],
  "extraFiles": [
    {
      "from": "scrcpy-win64",
      "to": "scrcpy-win64",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "icon.ico",
    "signAndEditExecutable": true,
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "icon.ico",
    "uninstallerIcon": "icon.ico",
    "installerHeaderIcon": "icon.ico",
    "include": "build/installer.nsh",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "unicode": true
  },
  "electronDist": ".electron-cache/electron",
  "npmRebuild": false,
  "asar": true,
  "asarUnpack": [
    "electron/lib/localization.cjs",
    "electron/locales/*.json",
    "electron/lib/performance-worker.cjs",
    "electron/lib/task-center-worker.cjs",
    "electron/lib/task-run-manifest.cjs",
    "electron/lib/ai-tools-sessions-worker.cjs",
    "electron/lib/ai-tools-session-parser.cjs",
    "electron/lib/ai-tools-session-archives.cjs",
    "electron/lib/ai-tools-migration-common.cjs",
    "electron/lib/ai-tools-router-worker.cjs",
    "electron/lib/ai-tools-file-safety.cjs",
    "node_modules/@serialport/bindings-cpp/prebuilds/**/*"
  ],
  "compression": "maximum",
  "removePackageScripts": true,
  "removePackageKeywords": true,
  "publish": {
    "provider": "github",
    "owner": "xiandan001",
    "repo": "adb-workbench",
    "releaseType": "release"
  }
}

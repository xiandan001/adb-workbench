{
  "appId": "com.scrcpy.gui",
  "productName": "卓控台",
  "artifactName": "adb-workbench-setup-${version}.${ext}",
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!electron/api-keys.cjs",
    "!electron/api-keys.template.cjs",
    "!native/builtin-ai/**/*",
    "!**/credentials.generated.h",
    "!**/.env",
    "!**/.env.*",
    "!**/*.{obj,pdb,rsp}",
    "icon.png"
  ],
  "afterPack": "./scripts/build-builtin-ai.cjs",
  "extraFiles": [
    {
      "from": "hdc",
      "to": "hdc",
      "filter": ["hdc.exe", "libusb_shared.dll", "LICENSE*", "NOTICE*", "agent/**/*"]
    },
    {
      "from": "scrcpy-win64",
      "to": "scrcpy-win64",
      "filter": [
        "**/*"
      ]
    }
  ],
  "extraResources": [
    { "from": "build/generated/installer-ui/VeyloInstallWait.exe", "to": "installer-wait.exe" },
    { "from": "build/generated/builtin-ai/veylo-builtin-ai.node", "to": "veylo-builtin-ai.node" },
    { "from": "build/firmware-drivers", "to": "firmware-drivers", "filter": ["**/*.inf", "**/*.cat", "**/*.sys"] }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "icon.ico",
    "signAndEditExecutable": true,
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": false,
    "installerLanguages": ["en_US", "zh_CN", "zh_TW", "ja_JP", "ko_KR"],
    "installerIcon": "icon.ico",
    "uninstallerIcon": "icon.ico",
    "installerHeaderIcon": "icon.ico",
    "include": "build/installer.nsh",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "unicode": true
  },
  "electronDist": ".electron-cache/electron",
  "npmRebuild": false,
  "asar": true,
  "asarUnpack": [
    "electron/assets/installer-active.ps1",
    "electron/assets/update-launch.ps1",
    "electron/assets/update-processes.ps1",
    "electron/lib/device-platform.cjs",
    "electron/lib/device-registry.cjs",
    "electron/lib/device-invocation.cjs",
    "electron/lib/device-discovery.cjs",
    "electron/lib/device-connection.cjs",
    "electron/lib/adb-device-parser.cjs",
    "electron/lib/adb-runtime.cjs",
    "electron/lib/android-tool-cleanup.cjs",
    "electron/lib/hdc-runtime.cjs",
    "electron/lib/hdc-device-parser.cjs",
    "electron/lib/harmony-*.cjs",
    "electron/lib/localization.cjs",
    "electron/lib/installer-language.cjs",
    "electron/locales/*.json",
    "electron/lib/performance-worker.cjs",
    "electron/lib/task-center-worker.cjs",
    "electron/lib/task-step-evidence.cjs",
    "electron/lib/task-run-manifest.cjs",
    "electron/lib/task-rerun.cjs",
    "electron/lib/task-platform.cjs",
    "electron/lib/task-ai-summary-bridge.cjs",
    "electron/lib/ai-workspace-worker.cjs",
    "electron/lib/ai-workspace-compute.cjs",
    "electron/lib/ai-workspace-store-async.cjs",
    "electron/lib/ai-workspace-evidence.cjs",
    "electron/lib/ai-workspace-diagnostics.cjs",
    "electron/lib/ai-workspace-selection.cjs",
    "electron/lib/ai-workspace-limits.cjs",
    "electron/lib/ai-workspace-history.cjs",
    "electron/lib/ai-workspace-schema.cjs",
    "electron/lib/ai-context-limits.json",
    "electron/lib/ai-model-request-limits.cjs",
    "electron/lib/ai-workspace-redaction.cjs",
    "electron/lib/ai-evidence-basket-storage.cjs",
    "electron/lib/ai-workspace-request-plan.cjs",
    "electron/lib/ai-artifact-reader.cjs",
    "electron/lib/serial-ai-evidence.cjs",
    "electron/lib/ip-control-ai-evidence.cjs",
    "electron/lib/serial-format.cjs",
    "electron/lib/analysis-language.cjs",
    "electron/lib/feedback-policy.cjs",
    "electron/lib/ai-outbound-worker.cjs",
    "electron/lib/ai-outbound-policy.cjs",
    "electron/lib/artifact-export-transform-worker.cjs",
    "electron/lib/ai-tools-sessions-worker.cjs",
    "electron/lib/ai-tools-session-parser.cjs",
    "electron/lib/ai-tools-session-archives.cjs",
    "electron/lib/ai-tools-migration-common.cjs",
    "electron/lib/ai-tools-router-worker.cjs",
    "electron/lib/log-file-worker.cjs",
    "electron/lib/log-file-reader.cjs",
    "electron/lib/log-line-parser.cjs",
    "electron/lib/log-bounded-lines.cjs",
    "electron/lib/log-capture-buffer.cjs",
    "electron/lib/log-diagnostic-regex-worker.cjs",
    "electron/lib/log-filter-worker.cjs",
    "electron/lib/log-filter-policy.cjs",
    "electron/lib/log-session-worker.cjs",
    "electron/lib/log-sessions.cjs",
    "electron/lib/log-session-jobs.cjs",
    "electron/lib/log-session-operations.cjs",
    "electron/lib/artifact-export.cjs",
    "electron/lib/artifact-export-transform.cjs",
    "electron/lib/ai-tools-file-safety.cjs",
    "node_modules/@serialport/bindings-cpp/prebuilds/**/*"
  ],
  "compression": "maximum",
  "removePackageScripts": true,
  "removePackageKeywords": true,
  "publish": {
    "provider": "github",
    "owner": "xiandan001",
    "repo": "adb-workbench",
    "releaseType": "release"
  }
}

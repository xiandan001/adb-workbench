{
  "name": "adb-workbench",
  "private": true,
  "version": "4.7.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "check:i18n": "node scripts/check-i18n.cjs",
    "test:i18n": "node --test --test-concurrency=4 tests/localization*.test.* tests/i18n-*.test.*",
    "prebuild": "npm run check:i18n",
    "preelectron:build": "npm run check:i18n",
    "build": "vite build",
    "lint": "eslint .",
    "test:onboarding": "node --test tests/task-center-onboarding-state.test.cjs tests/task-center-onboarding-ui-model.test.mjs",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "^6.8.9",
    "json5": "2.2.3",
    "jsonc-parser": "3.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "serialport": "13.0.0",
    "smol-toml": "1.9.1",
    "ssh2": "1.17.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.2",
    "@babel/traverse": "7.29.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "lucide-react": "^1.8.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4",
    "wait-on": "^9.0.4"
  }
}
